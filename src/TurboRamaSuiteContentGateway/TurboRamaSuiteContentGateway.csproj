<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The referenced control-plane project contributes its own Web SDK content
         files. The gateway owns the publish-root appsettings and lock file. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TurboRamaSuiteOnlineServer/TurboRamaSuiteOnlineServer.csproj" />
    <Compile Include="../TurboRamaSuiteContentPublisher/PublicNetworkPolicy.cs" Link="Shared/PublicNetworkPolicy.cs" />
  </ItemGroup>
</Project>
