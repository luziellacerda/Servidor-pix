[Unit]
Description=TurboRama Suite content entitlement reconciliation
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=turborama-suite-publisher
Group=turborama-suite-publisher
WorkingDirectory=/var/lib/turborama-suite-content
EnvironmentFile=/etc/turborama-suite-content/publisher.env
ExecStart=/usr/bin/dotnet /opt/turborama-suite-content-publisher/TurboRamaSuiteContentPublisher.dll reconcile-entitlements
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

# Intentionally no [Install] target and no timer. Run only as a controlled,
# audited recovery step; the commerce transaction maintains new entitlements.
