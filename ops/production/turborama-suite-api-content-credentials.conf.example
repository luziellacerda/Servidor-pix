# Install as:
# /etc/systemd/system/turborama-suite-api.service.d/content-credentials.conf
# Provision the root-owned canonical credential as
# /etc/credstore/content-grant-token-pepper (0400), or pass it to the service
# manager under that ID. A missing credential is intentionally non-fatal to
# systemd: the application keeps licensing v1 up and content fails closed.
[Service]
LoadCredential=content-grant-token-pepper
