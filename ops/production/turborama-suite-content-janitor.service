[Unit]
Description=TurboRama Suite content retention janitor
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/opt/turborama-suite-content-janitor/TurboRamaSuiteContentJanitor.dll
ConditionPathExists=/etc/turborama-suite-content-janitor/janitor.env
ConditionPathExists=/etc/turborama-suite-content-janitor/janitor.connection

[Service]
Type=oneshot
TimeoutStartSec=10min
User=turborama-suite-maintenance
Group=turborama-suite-maintenance
WorkingDirectory=/opt/turborama-suite-content-janitor
EnvironmentFile=/etc/turborama-suite-content-janitor/janitor.env
ExecStart=/usr/bin/dotnet /opt/turborama-suite-content-janitor/TurboRamaSuiteContentJanitor.dll run-once
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/turborama-suite-content-janitor /opt/turborama-suite-content-janitor

# Triggered only by turborama-suite-content-janitor.timer.
