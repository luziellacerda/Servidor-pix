[Unit]
Description=Deliver TurboRama SUITE connection notifications through the supported TurboBox queue
After=turborama-suite-admin.service
[Service]
Type=oneshot
User=lz-servidor
Environment=SUITE_ADMIN_SOCKET=/run/turborama-suite-admin/admin.sock
Environment=SUITE_ADMIN_TOKEN_FILE=/etc/turborama-suite/admin-token
ExecStart=/usr/bin/php /opt/turborama-suite/ops/turborama-suite-connection-whatsapp.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
