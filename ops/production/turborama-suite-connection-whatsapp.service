[Unit]
Description=Deliver TurboRama SUITE connection notifications through the supported TurboBox queue
After=turborama-suite-admin.service
[Service]
Type=oneshot
User=lz-servidor
Group=turborama-suite-bff
EnvironmentFile=/etc/turborama-suite-bff/admin.env
ExecStart=/usr/bin/php /opt/turborama-suite/ops/turborama-suite-connection-whatsapp.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/home/lz-servidor/HOSTINGER\x20SITE\x20DOCUMENTOS/sistema2026.lzgames.com.br/public_html/turbobox/.data
