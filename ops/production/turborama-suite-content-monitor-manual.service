[Unit]
Description=TurboRama single-item manual content link check
After=network-online.target postgresql.service turborama-suite-content-gateway.service
Wants=network-online.target
Requires=postgresql.service turborama-suite-content-gateway.service
OnSuccess=turborama-suite-content-alert.service

[Service]
Type=oneshot
User=turborama-suite-content-monitor
Group=turborama-suite-content-monitor
WorkingDirectory=/opt/turborama-suite-content-monitor
EnvironmentFile=/etc/turborama-suite-content-monitor/monitor.env
Environment=SUITE_CONTENT_MONITOR_DIRECT_MODE=1
LoadCredential=candidate-url-keyring
LoadCredential=content-url-keyring
LoadCredential=content-allowed-hosts
ExecStart=/usr/bin/dotnet /opt/turborama-suite-content-monitor/TurboRamaSuiteContentMonitor.dll manual-once
TimeoutStartSec=2min
UMask=0077
RuntimeDirectory=turborama-suite-content-monitor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/turborama-suite-content-monitor /etc/turborama-suite-content /opt/turborama-suite-content-monitor
ReadWritePaths=/var/lib/turborama-suite-content-monitor
CapabilityBoundingSet=
AmbientCapabilities=
