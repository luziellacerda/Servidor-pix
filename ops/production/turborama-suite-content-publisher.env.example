SUITE_CONTENT_PUBLISHER_CONNECTION_FILE=/etc/turborama-suite-content/publisher.connection
SUITE_CONTENT_GATEWAY_KEYRING_READINESS_URL=http://127.0.0.1:5191/ready/keyring/prove
# The publisher unit injects content-allowed-hosts through LoadCredential.
SUITE_CONTENT_EXPECTED_INVENTORY_SHA256=replace-with-64-lowercase-hex-after-secure-staging
SUITE_CONTENT_EXPECTED_VISUAL_SHA256=replace-with-64-lowercase-hex-from-pinned-client-release
