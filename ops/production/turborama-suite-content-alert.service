[Unit]
Description=Queue TurboRama broken content links for WhatsApp notification
After=turbobox-notifications.service

[Service]
Type=oneshot
User=lz-servidor
Group=lz-servidor
EnvironmentFile=/etc/turborama-suite-content-alert/alert.env
ExecStart=/usr/bin/php /opt/turborama-suite-content-alert/alert-bridge.php
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/run/turborama-suite-content-monitor
ReadWritePaths="/home/lz-servidor/HOSTINGER SITE DOCUMENTOS/sistema2026.lzgames.com.br/public_html/turbobox/.data"
