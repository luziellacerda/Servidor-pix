# This file contains paths and switches only. Keep the actual database password,
# bearer-token pepper, URL keys and upstream hosts in the protected files below.
Suite__Content__Enabled=true
ConnectionStrings__SuiteContentGatewayStoreFile=/etc/turborama-suite-content/gateway.connection
# Grant pepper, URL keyring and allowed-host snapshot are injected by the unit.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
