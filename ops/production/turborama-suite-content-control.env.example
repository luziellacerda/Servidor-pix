# Merge these settings into the existing turborama-suite-api environment.
# Values are paths/public pins only; actual secrets remain in protected files.
Suite__Content__Enabled=true
ConnectionStrings__SuiteContentApiStoreFile=/etc/turborama-suite-content/control.connection
Suite__ContentAssertionPrivateKeyPemFile=/etc/turborama-suite-content/content-assertion-private.pem
Suite__ContentAssertionExpectedKeyId=replace-with-64-lowercase-sha256-of-content-public-spki
Suite__Content__GatewayGrantPepperProofUri=http://127.0.0.1:5191/ready/grant-pepper/prove
# Suite:ContentGrantTokenPepperFile is resolved from the systemd credential directory.
