[Unit]
Description=Station outbound bandwidth sharing
Wants=network-online.target
After=network-online.target
Before=station-network-priority.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/station-network-qos/policy.py apply
ExecStop=/usr/bin/python3 /opt/station-network-qos/policy.py stop
ExecReload=/usr/bin/python3 /opt/station-network-qos/policy.py apply
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
