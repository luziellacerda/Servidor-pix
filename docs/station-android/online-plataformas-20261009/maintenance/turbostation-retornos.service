[Unit]
Description=Conferir e implementar retornos e capas do TurboStation
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/lz-servidor/.local/share/turbostation-retornos/monitor.py
WorkingDirectory=/mnt/DADOS/servidor-pix-station-nes-20261012
Environment=PATH=/home/lz-servidor/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
