    "/v1/station/online/relay": {
      "get": {
        "operationId": "stationOnlineRelay",
        "description": "No query string. Ticket+fresh request proof verified before one-use consumption; exact negotiated subprotocol. After HTTP101 the TSR2 binary framing applies. Ticket-only alternative is exclusively for legacy v1 sessions that have not adopted request proof; v2 requires both.",
        "security": [
          {
            "relayTicket": [],
            "requestProof": []
          },
          {
            "relayTicket": []
          }
        ],
        "parameters": [
          {
            "name": "Sec-WebSocket-Protocol",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "station-relay.v1",
                "station-stream.v2"
              ]
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade"
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
