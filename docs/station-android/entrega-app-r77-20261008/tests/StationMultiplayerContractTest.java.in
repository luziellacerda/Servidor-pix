package org.emulationstation.frontend.netplay;
import org.json.*;
import java.util.*;
import java.nio.*;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.concurrent.*;

final class StationMultiplayerContractTest {
    static int checks,profileChecks,wireChecks,startChecks,coordinatorChecks;
    interface Action{void run()throws Exception;}
    static void check(boolean value,String label){checks++;if(!value)throw new AssertionError(label);}
    static void rejects(Action run,String label)throws Exception {checks++;try{run.run();}catch(Exception expected){return;}throw new AssertionError("Accepted: "+label);}
    static JSONObject copy(JSONObject value){return new JSONObject(value.toString());}
    static String sha(String value)throws Exception{return StationOnlineGame.hex(MessageDigest.getInstance("SHA-256").digest(value.getBytes(StandardCharsets.UTF_8)));}
    static final String HASH="a".repeat(64),CORE="b".repeat(64),RUNTIME="c".repeat(64);
    static JSONObject engine(String platform){return new JSONObject().put("platform",platform).put("engineId","fixture-engine").put("coreSha256",CORE).put("runtimeSha256",RUNTIME).put("options","");}
    static JSONObject profile(String platform,String controller,int max,int[] allowed)throws Exception {
        int[] devices;String options="";
        switch(controller){case "standard-2p-v1":devices=new int[]{1,1};break;case "snes-multitap-port2-v1":devices=new int[]{1,257,1,1,1};break;case "megadrive-sega-teamplayer-v1":devices=new int[]{1,1,1,1,1,1,1,1};options="clownmdemu_input_protocol = \"sega\"\n";break;default:devices=new int[]{1,1,1,1};options="clownmdemu_input_protocol = \"ea\"\n";}
        return new JSONObject().put("approved",true).put("itemId","fixture-item").put("contentSha256",HASH).put("platform",platform).put("engineId","fixture-engine").put("coreSha256",CORE).put("runtimeSha256",RUNTIME).put("profileId","fixture-profile").put("profileSha256",sha(StationMultiplayerProfile.canonical(controller,devices,options))).put("controllerProfile",controller).put("mode","fixture-mode").put("maximumPlayers",max).put("allowedPlayerCounts",new JSONArray(allowed));
    }
    static JSONObject snapshot(JSONObject profile){return new JSONObject().put("multiplayerVersion",3).put("capability","station-multiplayer.v3").put("profiles",new JSONArray().put(profile));}
    static StationMultiplayerProfile load(JSONObject p)throws Exception{return StationMultiplayerProfile.find(snapshot(p),"fixture-item",engine(p.getString("platform")));}
    static JSONObject room(StationMultiplayerProfile p,int capacity,int count)throws Exception {
        JSONObject room=p.fields(new JSONObject()).put("roomId","0".repeat(32)).put("platform",p.platform).put("controllerProfile",p.controllerProfile).put("mode",p.mode).put("maximumPlayers",p.maximumPlayers).put("allowedPlayerCounts",new JSONArray(p.allowed)).put("hostId","p1").put("transport","relay-wss-v3").put("recoveryProtocol","station-stream.v3").put("state","waiting").put("capacity",capacity);
        JSONArray roster=new JSONArray();for(int n=count;n>=1;n--)roster.put(new JSONObject().put("peerId","p"+n).put("slot",n).put("ready",true));return room.put("roster",roster);
    }
    static void profiles()throws Exception {
        int before=checks;
        String known="{\"schemaVersion\":1,\"controllerProfile\":\"snes-multitap-port2-v1\",\"devices\":[1,257,1,1,1],\"coreOptions\":\"\"}";
        check(known.equals(StationMultiplayerProfile.canonical("snes-multitap-port2-v1",new int[]{1,257,1,1,1},"")),"canonical SNES bytes");
        for(String name:new String[]{"standard-2p-v1","snes-multitap-port2-v1","megadrive-sega-teamplayer-v1","megadrive-ea-4way-v1"}) {
            String platform=name.startsWith("megadrive")?"megadrive":"snes";int max=name.equals("standard-2p-v1")?2:4;JSONObject value=profile(platform,name,max,max==2?new int[]{2}:new int[]{2,3,4});StationMultiplayerProfile p=load(value);
            for(int n=0;n<7;n++)check(p.permits(n)==(n>=2&&n<=max),"permits "+name+" "+n);
            for(String key:new String[]{"approved","contentSha256","coreSha256","runtimeSha256","profileId","profileSha256","mode","controllerProfile","allowedPlayerCounts"}){JSONObject bad=copy(value);bad.remove(key);rejects(()->load(bad),"missing "+key);}
            for(String key:new String[]{"contentSha256","coreSha256","runtimeSha256","profileSha256"})for(String badHash:new String[]{"",HASH.toUpperCase(),HASH.substring(1),"z".repeat(64),HASH+"0"}){JSONObject bad=copy(value).put(key,badHash);rejects(()->load(bad),"bad hash "+key);}
            rejects(()->load(copy(value).put("approved",false)),"unapproved");
            rejects(()->StationMultiplayerProfile.find(snapshot(value),"unknown",engine(platform)),"unknown game no default2");
            rejects(()->StationMultiplayerProfile.find(snapshot(value).put("multiplayerVersion",2),"fixture-item",engine(platform)),"v2 no classification fallback");
            rejects(()->StationMultiplayerProfile.find(snapshot(value).put("profiles",new JSONArray().put(value).put(value)),"fixture-item",engine(platform)),"duplicate profile");
            for(int count:new int[]{0,1,5})rejects(()->load(copy(value).put("maximumPlayers",count)),"unsupported maximum");
            for(int[] allowed:new int[][]{{},{1},{2,2},{3,2},{4,3},{2,5}})rejects(()->load(copy(value).put("allowedPlayerCounts",new JSONArray(allowed))),"invalid allowed counts");
            for(int capacity=2;capacity<=max;capacity++)for(int count=1;count<=capacity;count++){
                JSONObject r=room(p,capacity,count);p.verify(r);check(StationMultiplayerProfile.slot(r,"p1")==1,"host identity despite reverse order");check(StationMultiplayerProfile.mask(r)==(1<<count)-1,"roster mask");
                for(String key:new String[]{"itemId","contentSha256","engineId","coreSha256","runtimeSha256","profileId","profileSha256","platform","mode","controllerProfile","maximumPlayers","allowedPlayerCounts"}){JSONObject bad=copy(r).put(key,"different");rejects(()->p.verify(bad),"room identity "+key);}
                JSONObject dup=copy(r);dup.getJSONArray("roster").put(new JSONObject().put("peerId","p1").put("slot",1));rejects(()->p.verify(dup),"duplicate roster identity");
                JSONObject slot=copy(r);slot.getJSONArray("roster").getJSONObject(0).put("slot",5);rejects(()->p.verify(slot),"out of range slot");
                if(count==1)rejects(()->p.verify(copy(r).put("state","playing")),"single cannot start");
            }
        }
        StationMultiplayerProfile onlyFour=load(profile("snes","snes-multitap-port2-v1",4,new int[]{4}));check(!onlyFour.permits(2)&&!onlyFour.permits(3)&&onlyFour.permits(4),"mode may require four");rejects(()->onlyFour.verify(room(onlyFour,4,3).put("state","playing")),"three cannot play four-only mode");
        JSONObject firstMode=profile("snes","snes-multitap-port2-v1",4,new int[]{2,3,4}),secondMode=copy(firstMode).put("profileId","other-mode").put("mode","tag-team");JSONObject multiple=snapshot(firstMode).put("profiles",new JSONArray().put(firstMode).put(secondMode));
        rejects(()->StationMultiplayerProfile.find(multiple,"fixture-item",engine("snes")),"ambiguous mode needs explicit choice");
        check(StationMultiplayerProfile.find(multiple,"fixture-item",engine("snes"),"other-mode").mode.equals("tag-team"),"explicit mode selection");
        check(StationMultiplayerProfile.choices(multiple,"fixture-item",engine("snes")).size()==2,"both approved modes exposed");
        rejects(()->StationMultiplayerProfile.choices(multiple,"fixture-item",engine("snes")).clear(),"choices immutable");
        profileChecks=checks-before;
    }
    static JSONObject startSnapshot(JSONObject room){return new JSONObject().put("selfId","p1").put("room",room).put("transports",new JSONArray().put("relay-wss-v3"));}
    static void start()throws Exception {
        int before=checks;StationMultiplayerProfile p=load(profile("snes","snes-multitap-port2-v1",4,new int[]{2,3,4}));
        for(int capacity=2;capacity<=4;capacity++)for(int count=1;count<=capacity;count++){
            JSONObject r=room(p,capacity,count),s=startSnapshot(r);check(StationRoomStartState.reason(s).isEmpty()==(count>=2),"start counts");
            check(!StationRoomStartState.reason(copy(s).put("selfId","p2")).isEmpty(),"guest cannot start");
            JSONObject notReady=copy(s);notReady.getJSONObject("room").getJSONArray("roster").getJSONObject(0).put("ready",false);check(!StationRoomStartState.reason(notReady).isEmpty(),"ready barrier");
            check(!StationRoomStartState.reason(copy(s).put("transports",new JSONArray())).isEmpty(),"transport gate");
        }
        check(!StationRoomStartState.reason(null).isEmpty(),"missing room");
        JSONObject legacy=new JSONObject().put("selfId","p1").put("transports",new JSONArray().put("relay-wss-v2")).put("room",new JSONObject().put("hostId","p1").put("state","waiting").put("recoveryProtocol","station-stream.v2").put("members",new JSONArray().put("p1").put("p2")).put("ready",new JSONArray().put("p1").put("p2")));
        check(StationRoomStartState.reason(legacy).isEmpty(),"v2 preserved");startChecks=checks-before;
    }
    static JSONObject ticket(String link){return ticket(link,true,1);}
    static JSONObject ticket(String link,boolean host,int owner){return new JSONObject().put("linkId",link).put("path","/v1/station/online/multiplayer/relay").put("protocol","station-stream.v3").put("expiresInSeconds",60).put("windowBytes",262144).put("ticket","T".repeat(43)).put("requestProof","v1.1234567890."+"p".repeat(22)+".proof").put("hostSide",host).put("ownerSlot",owner);}
    static JSONObject launch(int count,boolean host,int localSlot){JSONArray links=new JSONArray();for(int i=count;i>=2;i--)if(host||i==localSlot)links.put(new JSONObject().put("linkId","link"+i).put("guestSlot",i).put("ticket",ticket("link"+i,host,localSlot)));return new JSONObject().put("role",host?"host":"guest").put("localSlot",localSlot).put("participantCount",count).put("expectedDeviceMask",(1<<count)-1).put("port",55435).put("multiplayerLinks",links);}
    static final class Observer implements StationMultiplayerSession.Listener {
        volatile long epoch;volatile boolean pause=true,visible=true;int ready,fatal;Map<String,Long> serial=new HashMap<>();List<Integer> bound=new ArrayList<>();
        public void nativeControl(long e,boolean p,boolean v){epoch=e;pause=p;visible=v;}public long nativeStatus(){return 0;}public boolean nativeStalled(){return false;}
        public boolean bind(int source,int slot){bound.add(slot);return true;}public void unbind(int source,int slot){}public void ticket(String id,long value){serial.put(id,value);}public void ready(){ready++;}public void state(boolean waiting,boolean sync){}public void fatal(String category){fatal++;}public void trace(String text){}
    }
    static void coordinator()throws Exception {
        int before=checks;
        for(int count=2;count<=4;count++)for(boolean host:new boolean[]{true,false}) {
            StationMultiplayerTunnel.reset();Observer o=new Observer();StationMultiplayerSession s=new StationMultiplayerSession(launch(count,host,host?1:count),o);List<StationMultiplayerTunnel> all=new ArrayList<>(StationMultiplayerTunnel.instances);s.start();check(o.pause,"initial barrier");
            for(int i=0;i<all.size();i++){all.get(i).listener.ready();all.get(i).epoch(1,true);check(o.pause==(i<all.size()-1),"all-link barrier "+count+" "+i);}check(o.ready==1,"single ready notification");for(var t:all)t.listener.ready();check(o.ready==1,"ready not repeated");
            if(host)for(var t:all){check(t.binding!=null,"host binding");t.binding.bind(40000+o.bound.size());}else check(all.get(0).binding==null,"guest does not assign host sockets");
            if(host)for(int i=0;i<o.bound.size();i++)check(o.bound.get(i)==count-i-1,"out of order physical arrival uses signed slot");
            all.get(0).epoch(2,false);check(o.pause&&o.epoch==2,"one link recovery pauses whole core");
            for(var t:all)t.epoch(1,true);check(o.pause&&o.epoch==2,"stale epoch cannot resume");
            for(int i=0;i<all.size();i++){all.get(i).epoch(2,true);check(o.pause==(i<all.size()-1),"recovery barrier");}
            all.get(0).available=false;all.get(0).listener.state(false,false);check(o.pause,"unavailable playing channel pauses");all.get(0).available=true;all.get(0).epoch(2,true);check(!o.pause,"availability restored");
            all.get(0).listener.state(true,false);check(!o.pause&&o.epoch==2,"old epochless waiting callback cannot erase new PLAYING");
            s.visible(false);check(o.pause&&!o.visible,"background pauses");s.visible(true);check(o.pause&&o.visible,"foreground waits fresh link status");for(var t:all)t.epoch(3,true);check(!o.pause&&o.epoch==3,"fresh foreground barrier");
            String id="link"+count;var first=all.get(0);first.listener.ticket();long serial=o.serial.get(id);JSONObject fresh=ticket(id,host,host?1:count);s.provide(id,serial-1,fresh);check(first.provides==0,"stale ticket ignored");s.provide(id,serial,fresh);check(first.provides==1,"current ticket provided");
            rejects(()->s.provide(id,serial,copy(fresh).put("linkId","wrong")),"wrong link ticket");rejects(()->s.provide(id,serial,copy(fresh).put("hostSide",!host)),"wrong ticket role");rejects(()->s.provide(id,serial,copy(fresh).put("ownerSlot",5)),"wrong ticket owner");s.unavailable(id,serial-1,false);check(first.unavailables==0,"stale failure ignored");s.unavailable(id,serial,false);check(first.unavailables==1,"current failure recorded");
            s.close();check(all.stream().allMatch(t->t.closed),"close all links");int old=o.ready;for(var t:all)t.listener.ready();check(o.ready==old,"no ready after close");
        }
        for(int count:new int[]{0,1,5})rejects(()->new StationMultiplayerSession(launch(count,true,1),new Observer()),"invalid participant count");
        for(int mask:new int[]{0,1,3,7,16,31})rejects(()->new StationMultiplayerSession(launch(4,true,1).put("expectedDeviceMask",mask),new Observer()),"inconsistent mask");
        rejects(()->new StationMultiplayerSession(launch(4,true,1).put("localSlot",3),new Observer()),"host slot must be one");
        for(int round=0;round<24;round++){
            StationMultiplayerTunnel.reset();Observer observer=new Observer();try(StationMultiplayerSession session=new StationMultiplayerSession(launch(4,true,1),observer)){
                session.start();List<StationMultiplayerTunnel> channels=new ArrayList<>(StationMultiplayerTunnel.instances);CountDownLatch start=new CountDownLatch(1);List<Thread> threads=new ArrayList<>();
                for(var channel:channels){Thread thread=new Thread(()->{try{start.await();for(long epoch=1;epoch<=32;epoch++){channel.epoch(epoch,false);Thread.yield();channel.epoch(epoch,true);}}catch(InterruptedException e){Thread.currentThread().interrupt();}});thread.setDaemon(true);threads.add(thread);thread.start();}
                start.countDown();for(Thread thread:threads){thread.join(3000);check(!thread.isAlive(),"concurrent epochs terminate");}check(observer.epoch==32&&!observer.pause,"all concurrent channels finish at latest epoch");
                for(var channel:channels){channel.epoch(31,true);channel.listener.state(true,false);}check(observer.epoch==32&&!observer.pause,"old callbacks cannot undo latest epoch barrier");
            }
        }
        for(String field:new String[]{"path","protocol","linkId"})rejects(()->StationMultiplayerSession.checkTicket(ticket("link").put(field,"wrong"),"link"),"ticket "+field);
        for(int seconds:new int[]{0,61})rejects(()->StationMultiplayerSession.checkTicket(ticket("link").put("expiresInSeconds",seconds),"link"),"ticket expiry");
        coordinatorChecks=checks-before;
    }
    static void wire()throws Exception {
        int before=checks;for(int type=1;type<=13;type++){byte[] data=type==3?new byte[]{1,2,3}:new byte[0];StationMultiplayerWire v=new StationMultiplayerWire(type,42,0,data);byte[] encoded=v.encode();check(encoded[3]==0x33,"TSR3 distinct");StationMultiplayerWire decoded=StationMultiplayerWire.decode(ByteBuffer.wrap(encoded));check(decoded.type==type&&decoded.offset==42&&Arrays.equals(decoded.data,data),"wire round trip");for(int at:new int[]{0,3,5,6,7}){byte[] bad=encoded.clone();bad[at]^=0x10;rejects(()->StationMultiplayerWire.decode(ByteBuffer.wrap(bad)),"wire reserved/magic");}}
        for(int size:new int[]{0,1,23,16409})rejects(()->StationMultiplayerWire.decode(ByteBuffer.wrap(new byte[size])),"wire bounds");
        StationMultiplayerWire.Bytes window=new StationMultiplayerWire.Bytes(32768);Random random=new Random(77);for(int i=0;i<128;i++){byte[] payload=new byte[16384];random.nextBytes(payload);long at=window.next;window.append(at,payload);check(Arrays.equals(window.read(at),payload),"window payload exact");window.append(at,payload);check(window.pending()==payload.length,"replay not duplicated");byte[] changed=payload.clone();changed[0]^=1;rejects(()->window.append(at,changed),"changed replay");window.confirm(window.next);check(window.pending()==0&&window.credit()==32768,"credit released");}
        rejects(()->window.confirm(window.next+1),"future ACK");rejects(()->window.confirm(window.delivered-1),"regressive ACK");wireChecks=checks-before;
    }
    public static void main(String[] args)throws Exception {profiles();start();coordinator();wire();System.out.println(new JSONObject().put("checks",checks).put("profiles",profileChecks).put("start",startChecks).put("coordinator",coordinatorChecks).put("wire",wireChecks).toString());}
}
