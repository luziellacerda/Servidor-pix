# Exemplo sem valores reais. Copie somente no servidor e mantenha o arquivo privado.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5187
TURBORAMA_SERVER_STATE_FILE=/var/lib/turborama-pix/state.json
TURBORAMA_SERVER_STATE_KEY=SUBSTITUA_POR_32_BYTES_ALEATORIOS_EM_BASE64
TURBORAMA_SERVER_SECRET_KEY=SUBSTITUA_POR_OUTROS_32_BYTES_ALEATORIOS_EM_BASE64
TURBORAMA_PAYMENT_EXPIRATION_MINUTES=15
TURBORAMA_ALLOW_HTTP_LOOPBACK=true
